{
  "name": "Synthetic savings and wallet contract",
  "description": "Fee-free USD savings, integer-cent balances, account lifecycle and linked transfer effects.",
  "variables": {},
  "cases": [
    {
      "id": "BK-01",
      "title": "Reject request with no credentials",
      "path": "/clients",
      "status": 401,
      "method": "POST",
      "assertions": {
        "stable error code": "data.error.code === \"AUTH_REQUIRED\""
      },
      "body": {
        "firstname": "Synthetic",
        "lastname": "Account Holder"
      },
      "headers": {},
      "cookieJar": false
    },
    {
      "id": "BK-02",
      "title": "Reject unexpected tenant",
      "path": "/clients",
      "status": 400,
      "method": "POST",
      "assertions": {
        "stable error code": "data.error.code === \"UNKNOWN_TENANT\""
      },
      "body": {
        "firstname": "Synthetic",
        "lastname": "Account Holder"
      },
      "headers": {
        "Authorization": "Bearer fixture-bank-writer",
        "Fineract-Platform-TenantId": "other"
      },
      "cookieJar": false
    },
    {
      "id": "BK-03",
