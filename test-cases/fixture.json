      "path": "/savingsaccounts/{{senderId}}?associations=transactions",
      "status": 200,
      "method": "GET",
      "assertions": {
        "contract conditions": "data.summary.accountBalance === 449.9 && data.transactions.some(t => t.transferId === Number(get(\"transferId\")) && t.type === \"withdrawal\" && t.amount === 250.1)"
      },
      "headers": {
        "Authorization": "Bearer fixture-bank-writer",
