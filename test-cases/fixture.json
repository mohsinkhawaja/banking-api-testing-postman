      "path": "/savingsaccounts/{{recipientId}}?associations=transactions",
      "status": 200,
      "method": "GET",
      "assertions": {
        "contract conditions": "data.summary.accountBalance === 250.1 && Math.round((data.summary.accountBalance + Number(get(\"senderAfterTransfer\"))) * 100) === 70000 && data.transactions.some(t => t.transferId === Number(get(\"transferId\")) && t.type === \"deposit\" && t.amount === 250.1)"
      },
      "headers": {
        "Authorization": "Bearer fixture-bank-writer",
        "Fineract-Platform-TenantId": "default"
      },
      "cookieJar": false
