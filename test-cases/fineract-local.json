      "path": "/savingsaccounts/{{senderId}}/transactions?command=deposit",
      "status": 200,
      "method": "POST",
      "assertions": {
        "transaction ID and sender": "Number.isInteger(data.resourceId) && data.savingsId === Number(get(\"senderId\"))"
