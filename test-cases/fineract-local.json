      "title": "Confirm sender balance and both ledger entries",
      "path": "/savingsaccounts/{{senderId}}?associations=transactions",
      "status": 200,
      "method": "GET",
      "assertions": {
        "700 remains after one deposit and withdrawal": "data.status.active && data.summary.accountBalance === 700 && data.transactions.some(t => t.id === Number(get(\"liveDepositId\")) && t.amount === 1000) && data.transactions.some(t => t.id === Number(get(\"liveWithdrawalId\")) && t.amount === 300)"
      },
      "headers": {
        "Authorization": "Basic {{basicAuth}}",
        "Fineract-Platform-TenantId": "{{tenantId}}"
      },
      "cookieJar": false,
