{
  "name": "Apache Fineract savings integration",
  "description": "Opt-in flow against a disposable loopback Fineract instance with a fee-free product and demo tenant.",
  "variables": {},
  "cases": [
    {
      "id": "FIN-01",
      "title": "Create synthetic primary client",
      "path": "/clients",
      "status": 200,
      "method": "POST",
      "assertions": {
        "integer client identifier": "Number.isInteger(data.resourceId)"
      },
      "body": {
        "locale": "en",
        "dateFormat": "yyyy-MM-dd",
        "officeId": "@number:officeId",
        "firstname": "Synthetic",
        "lastname": "Primary QA",
        "active": true,
        "activationDate": "{{runDate}}",
        "submittedOnDate": "{{runDate}}",
        "externalId": "{{runKey}}"
      },
      "headers": {
        "Authorization": "Basic {{basicAuth}}",
        "Fineract-Platform-TenantId": "{{tenantId}}"
      },
      "capture": {
        "clientId": "data.resourceId"
      },
      "cookieJar": false,
      "setup": [
        "const base = pm.variables.replaceIn(\"{{baseUrl}}\");",
        "if (!/^http:\\/\\/(localhost|127\\.0\\.0\\.1):[0-9]+\\/fineract-provider\\/api\\/v1$/.test(base)) {",
        "  pm.execution.skipRequest();",
        "  throw new Error(\"Set baseUrl to the disposable local Fineract API\");",
        "}",
        "pm.collectionVariables.set(\"runDate\", new Date().toISOString().slice(0, 10));",
        "pm.collectionVariables.set(\"runKey\", pm.variables.replaceIn(\"{{$guid}}\"));"
      ]
    },
    {
      "id": "FIN-02",
      "title": "Create receiver in the configured test office",
      "path": "/clients",
      "status": 200,
      "method": "POST",
      "assertions": {
        "distinct receiver identifier": "Number.isInteger(data.resourceId) && data.resourceId !== Number(get(\"clientId\"))"
      },
      "body": {
        "locale": "en",
        "dateFormat": "yyyy-MM-dd",
        "officeId": "@number:officeId",
        "firstname": "Synthetic",
        "lastname": "Receiver QA",
        "active": true,
        "activationDate": "{{runDate}}",
        "submittedOnDate": "{{runDate}}"
      },
      "headers": {
        "Authorization": "Basic {{basicAuth}}",
        "Fineract-Platform-TenantId": "{{tenantId}}"
      },
      "capture": {
        "clientTwo": "data.resourceId"
      },
      "cookieJar": false,
      "setup": [
        "const base = pm.variables.replaceIn(\"{{baseUrl}}\");",
        "if (!/^http:\\/\\/(localhost|127\\.0\\.0\\.1):[0-9]+\\/fineract-provider\\/api\\/v1$/.test(base)) {",
        "  pm.execution.skipRequest();",
        "  throw new Error(\"Set baseUrl to the disposable local Fineract API\");",
        "}"
      ]
    },
